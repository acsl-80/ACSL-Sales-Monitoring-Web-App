# Copy to .env.local and fill in. VITE_* vars are injected at build/runtime.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_PLACES_API_KEY=
# ACSL ERP Change Control base URL (no trailing slash); defaults to https://www.atmosfair.site/change-control if unset
VITE_ERP_CHANGE_CONTROL_URL=
